# LLM 配置
ZHIPU_API_KEY=your_api_key_here
LLM_MODEL=glm-5.1
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_MAX_TOKENS=4096
LLM_OUTPUT_MODE=standard

# 备用 LLM（留空则不启用）
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
FALLBACK_LLM_MAX_TOKENS=4096

# 浏览器 CDP 连接
CDP_HOST=localhost
CDP_PORT=9222
CDP_WS_URL=

# Agent 行为
AGENT_MAX_STEPS=100
AGENT_MAX_FAILURES=5
AGENT_LLM_TIMEOUT=120
AGENT_ACTION_TIMEOUT=30
RECONNECT_TIMEOUT=30

# 文本截断阈值
AGENT_TRUNCATE_EXTRACT_PAGE=8000
AGENT_TRUNCATE_EXTRACT_FALLBACK=2000
AGENT_TRUNCATE_READ_FILE=5000
AGENT_TRUNCATE_EVAL_RESULT=2000
AGENT_TRUNCATE_DISPLAY=500

# 下载追踪
TRACK_DOWNLOADS=false

# 敏感数据过滤（JSON 格式：{"占位符": "真实值"}）
SENSITIVE_DATA=

# 消息压缩
MESSAGE_COMPACTION_ENABLED=false
MESSAGE_COMPACTION_MODEL=
MESSAGE_COMPACTION_API_KEY=
MESSAGE_COMPACTION_BASE_URL=https://open.bigmodel.cn/api/anthropic
MESSAGE_COMPACTION_EVERY_N_STEPS=10
MESSAGE_COMPACTION_TRIGGER_CHARS=40000
MESSAGE_COMPACTION_KEEP_LAST=4
MESSAGE_COMPACTION_SUMMARY_MAX_CHARS=

# 计划系统
AGENT_ENABLE_PLANNING=false
AGENT_EXPLORATION_THRESHOLD=5
AGENT_REPLAN_FAILURE_THRESHOLD=3

# 可观测性
AGENT_ENABLE_OBSERVABILITY=false
AGENT_ENABLE_DECISION_ATTRIBUTION=false
AGENT_OBSERVABILITY_LOG_DIR=logs

# 文件上传安全限制（逗号分隔的允许上传目录路径，留空则不限制）
AGENT_ALLOWED_UPLOAD_PATHS=
