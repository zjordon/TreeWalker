{
  "rules": [
    {
      "path": "**",
      "merge_system_rule": true,
      "rule": "严重度边界（只产出必须修改的问题）：\n- 报告标准：不改就会出错的问题——正确性缺陷、数据损坏或泄露、安全漏洞、会在真实执行路径上失败的契约破坏。\n- 不要报告：测试覆盖/锚定建议、注释与命名措辞、日志与观测口径的对称性、对不可达或已被上游校验拦截状态的防御加固、代码风格与结构偏好、可维护性重构建议。\n- 每条意见必须给出具体失效场景：什么输入/状态 → 什么错误行为。给不出失效场景的发现不要输出。\n- 不确定是否值得修改时，不要报告。宁可零意见，不要凑数。"
    }
  ],
  "include": [
    "src/**/*.py",
    "tests/**/*.py",
    "examples/**/*.py",
    "scripts/*.{ps1,sh}",
    "web_ui/src/**/*.{ts,tsx,css}",
    "web_ui/*.{ts,json,html}",
    "recording_extension/{capture,entrypoints,shared}/**/*.{ts,tsx,vue,css,html}",
    "recording_extension/*.{ts,json}",
    "domain-skills/**/*.md",
    "pyproject.toml"
  ],
  "exclude": [
    "docs/**",
    "out/**",
    "logs/**",
    "evaluate_output/**",
    "rerun-history/**",
    ".venv/**",
    "dist/**",
    "**/__pycache__/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.wxt/**",
    "**/.output/**",
    "uv.lock",
    "package-lock.json",
    "_*"
  ]
}
